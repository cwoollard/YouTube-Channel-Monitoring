[Unit]
Description=Generate YouTube reports for all channels

[Service]
Type=oneshot
User=@USER@
Group=@GROUP@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/.venv/bin/python @APP_DIR@/youtube_multi_report.py --config @APP_DIR@/channels.json --output-dir @APP_DIR@/reports
