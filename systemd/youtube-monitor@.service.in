[Unit]
Description=YouTube Channel Monitor (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/.venv/bin/python @APP_DIR@/monitor_channel.py %i --config @APP_DIR@/channels.json
Restart=on-failure
RestartSec=120
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
